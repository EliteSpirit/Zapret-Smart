<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:app="using:ZapretSmart.App"
        xmlns:c="using:ZapretSmart.App.Controls"
        xmlns:vm="using:ZapretSmart.App.ViewModels"
        x:Class="ZapretSmart.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Zapret Smart"
        Icon="/Assets/app.png"
        Width="960" Height="640" MinWidth="820" MinHeight="540"
        Background="{DynamicResource ZsBackground}"
        FontFamily="{DynamicResource ZsFont}"
        FontSize="13"
        Classes.top-menu="{Binding MenuOnTop}">

  <!-- Frame снимается целиком при смене темы: снимок гаснет поверх новой темы (OverlayHost). -->
  <Panel x:Name="Frame">
    <c:BackdropView x:Name="Backdrop" Animated="{Binding AnimatedBackdrop}" />

    <!-- Меню колонкой слева или строкой сверху (настройка «Меню сверху»): раскладку задают стили App.axaml по классу окна top-menu. -->
    <Grid>
      <Border Classes="chrome" />
      <StackPanel Classes="logo" IsHitTestVisible="False">
        <TextBlock Text="Zapret" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource ZsText}" VerticalAlignment="Center" />
        <TextBlock Text="SMART" FontSize="10" FontWeight="SemiBold" LetterSpacing="3" Foreground="{DynamicResource ZsAccent}" VerticalAlignment="Center" />
      </StackPanel>

      <TabControl Classes="nav" x:Name="Tabs">

        <!-- ═══ Обход ═══ -->
        <TabItem AutomationProperties.Name="Обход">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="icon" Stroke="{Binding $parent[TabItem].Foreground}"
                    Data="M4.8,5 A6.5,6.5 0 1 0 13.2,5 M9,2.5 L9,9" />
              <TextBlock Text="Обход" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <!-- Отступы на содержимом, а не Padding у ScrollViewer: нижний Padding не входит в прокручиваемую высоту, и низ страницы обрезался. -->
          <ScrollViewer>
            <StackPanel Spacing="12" MaxWidth="804" Margin="22,18" HorizontalAlignment="Stretch">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Panel Width="14" Height="14" VerticalAlignment="Center">
                    <Ellipse Classes="pulse" Classes.on="{Binding IsRunning}" Classes.busy="{Binding IsSwitching}" />
                    <Ellipse Classes="dot" Classes.on="{Binding IsRunning}" Classes.busy="{Binding IsSwitching}" />
                  </Panel>
                  <TextBlock Classes="h1" Text="{Binding StatusText}" />
                </StackPanel>
                <TextBlock Classes="muted reveal" Text="{Binding WatchdogStatus}" Margin="24,0,0,0"
                           IsVisible="{Binding WatchdogStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Стратегия" Classes="caption" />
                  <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}"
                            IsEnabled="{Binding !IsRunning}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:StrategyItem">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding SelectedStrategy.Description, FallbackValue=''}" Classes="muted" />
                  <DockPanel Margin="0,4,0,0">
                    <Grid DockPanel.Dock="Left">
                      <Button x:Name="StartButton" Classes="primary swap" Classes.hidden="{Binding ShowStop}"
                              Content="Включить" Command="{Binding StartCommand}" />
                      <Button x:Name="StopButton" Classes="danger swap" Classes.hidden="{Binding !ShowStop}"
                              Content="Выключить" Command="{Binding StopCommand}" />
                    </Grid>
                    <TextBlock Classes="caption reveal" VerticalAlignment="Center" Margin="16,0,0,0"
                               Text="Сменить стратегию можно после выключения обхода."
                               IsVisible="{Binding IsRunning}" />
                  </DockPanel>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                      <Button x:Name="CopyLogButton" Classes="small subtle" Content="Скопировать" Click="OnCopyLog"
                              IsEnabled="{Binding Log.Count, Converter={x:Static app:Converters.IsPositive}}" />
                      <Button Classes="small subtle" Content="Очистить" Command="{Binding ClearLogCommand}"
                              IsEnabled="{Binding Log.Count, Converter={x:Static app:Converters.IsPositive}}" />
                    </StackPanel>
                    <TextBlock Text="Журнал движка" Classes="title" VerticalAlignment="Center" />
                  </DockPanel>
                  <Panel Height="260">
                    <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="LogItems" ItemsSource="{Binding Log}">
                        <!-- Журнал до 500 строк: без виртуализации каждая смена вкладки заново раскладывала их все. -->
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:String">
                            <TextBlock Classes="log" Text="{Binding}"
                                       Classes.warn="{Binding Converter={x:Static app:Converters.IsWarningLine}}"
                                       Classes.cmd="{Binding Converter={x:Static app:Converters.IsCommandLine}}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Здесь появится вывод движка"
                               IsVisible="{Binding Log.Count, Converter={x:Static app:Converters.IsZero}}" />
                  </Panel>
                </DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══ Стратегии: список + просмотр или конструктор ═══ -->
        <TabItem AutomationProperties.Name="Стратегии">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="icon" Stroke="{Binding $parent[TabItem].Foreground}"
                    Data="M7,5 L15.5,5 M7,9.5 L15.5,9.5 M7,14 L15.5,14 M3,5 L3.01,5 M3,9.5 L3.01,9.5 M3,14 L3.01,14" />
              <TextBlock Text="Стратегии" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <Grid ColumnDefinitions="230,*" Margin="22,18,22,0" DataContext="{Binding Editor}" x:DataType="vm:StrategyEditorViewModel">
            <DockPanel Grid.Column="0" Margin="0,0,14,14">
              <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Стратегии" Margin="0,0,0,14" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                <Button Classes="small" Content="Новая" Command="{Binding NewCommand}" />
                <Button Classes="small" Content="Копия" Command="{Binding CopyCommand}" />
                <Button x:Name="DeleteButton" Classes="small" Content="Удалить" IsEnabled="{Binding CanDeleteSelected}">
                  <Button.Flyout>
                    <Flyout Placement="TopEdgeAlignedLeft">
                      <StackPanel Spacing="8" MaxWidth="260">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}"
                                   Text="{Binding Name, StringFormat='Удалить «{0}»?'}" />
                        <TextBlock Classes="caption" Text="Файл стратегии будет стёрт, вернуть его не получится." />
                        <Button Classes="danger small" Content="Удалить" Margin="0,4,0,0" Click="OnDeleteConfirmed" />
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding LoadErrors}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <TextBlock Classes="error" Text="{Binding}" FontSize="12" Margin="0,0,0,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ListBox Classes="picker" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StrategyItem">
                    <DockPanel>
                      <Border Classes="pipe" DockPanel.Dock="Left" Width="3" Height="22" CornerRadius="1.5"
                              Margin="-7,0,9,0" VerticalAlignment="Center" />
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Origin}" Classes="caption" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1">
              <!-- Строка сохранения: только у своих стратегий. -->
              <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,10,0,14" Padding="14,10" IsVisible="{Binding !IsReadOnly}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="primary small" Content="Сохранить" Command="{Binding SaveCommand}"
                          VerticalAlignment="Top" Margin="12,0,0,0" />
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsValid}">
                    <Ellipse Classes="dot" Width="8" Height="8" Classes.saved="{Binding IsSaved}" Classes.pending="{Binding !IsSaved}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SaveStatus}" Foreground="{DynamicResource ZsText}" VerticalAlignment="Center" />
                  </StackPanel>
                  <ScrollViewer MaxHeight="90" IsVisible="{Binding !IsValid}">
                    <ItemsControl Classes="reveal" ItemsSource="{Binding Errors}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                          <TextBlock Classes="error" Text="{Binding}" Margin="0,0,0,4" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              <ScrollViewer x:Name="EditorScroll">
                <StackPanel Spacing="10" Margin="0,0,0,18">

                  <!-- Просмотр встроенной стратегии: читается как описание, а не как форма с серыми полями. -->
                  <StackPanel Spacing="10" IsVisible="{Binding IsReadOnly}" Classes="reveal">
                    <Border Classes="card" Padding="16,12">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="primary small" Content="Сделать копию" Command="{Binding CopyCommand}"
                                VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Classes="muted" VerticalAlignment="Center"
                                   Text="Встроенную стратегию менять нельзя. Сделайте копию и правьте её." />
                      </DockPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{Binding Name}" />
                        <TextBlock Classes="muted" Text="{Binding Description}"
                                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <WrapPanel Margin="0,4,0,0">
                          <Border Classes="chip" IsVisible="{Binding Tcp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Tcp, StringFormat='TCP {0}'}" />
                          </Border>
                          <Border Classes="chip" IsVisible="{Binding Udp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Udp, StringFormat='UDP {0}'}" />
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Profiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileEditorViewModel">
                          <Border Classes="card" Margin="0,0,0,14">
                            <StackPanel Spacing="12">
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="title" Text="{Binding Number, StringFormat='Профиль {0}'}" />
                                <TextBlock Classes="caption" Text="{Binding FilterSummary}" VerticalAlignment="Center" />
                              </StackPanel>
                              <ItemsControl ItemsSource="{Binding Chips}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ProfileChip">
                                    <Border Classes="chip" Classes.accent="{Binding IsAccent}">
                                      <TextBlock Text="{Binding Text}" />
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Border Classes="code">
                                <SelectableTextBlock Text="{Binding ArgsText}" FontFamily="{DynamicResource ZsMonoFont}" FontSize="13"
                                                     TextWrapping="Wrap" Foreground="{DynamicResource ZsText}" />
                              </Border>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Конструктор своей стратегии. -->
                  <StackPanel Spacing="10" IsVisible="{Binding !IsReadOnly}" Classes="reveal">
                    <Border Classes="card">
                      <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.ColumnSpan="3" Text="Название" Classes="caption" />
                        <TextBox Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Name}" Margin="0,6,0,14" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Описание" Classes="caption" />
                        <TextBox Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Description}" Margin="0,6,0,14"
                                 AcceptsReturn="True" TextWrapping="Wrap" Watermark="Для чего она и на каких сайтах проверена" />
                        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6">
                          <TextBlock Text="Перехват TCP (порты)" Classes="caption" />
                          <TextBox Text="{Binding Tcp}" Watermark="80,443" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Spacing="6">
                          <TextBlock Text="Перехват UDP (порты)" Classes="caption" />
                          <TextBox Text="{Binding Udp}" Watermark="443" />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Profiles}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileEditorViewModel">
                          <Border Classes="card" Margin="0,0,0,14">
                            <StackPanel Spacing="10">
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="small subtle" Content="Убрать"
                                        Command="{Binding Owner.RemoveProfileCommand}" CommandParameter="{Binding}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                  <TextBlock Classes="title" Text="{Binding Number, StringFormat='Профиль {0}'}" />
                                  <TextBlock Classes="caption" Text="{Binding FilterSummary}" VerticalAlignment="Center" />
                                </StackPanel>
                              </DockPanel>
                              <TextBlock Text="Списки доменов" Classes="caption" />
                              <ItemsControl ItemsSource="{Binding HostToggles}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ListToggle">
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,0,18,0" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <CheckBox IsChecked="{Binding AutoHostlist}"
                                        Content="Автосписок: движок сам добавляет домены, соединения с которыми обрываются как при блокировке" />
                              <TextBlock Text="Списки IP: только для трафика без имени сайта (игры, звонки)" Classes="caption" />
                              <ItemsControl ItemsSource="{Binding IpToggles}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ListToggle">
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,0,18,0" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Classes="error reveal" Text="{Binding ScopeHint}"
                                         IsVisible="{Binding ScopeHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              <TextBlock Text="Опции движка, по одной на строку, без «--»" Classes="caption" Margin="0,4,0,0" />
                              <TextBox Text="{Binding ArgsText}" AcceptsReturn="True" MinHeight="110"
                                       FontFamily="{DynamicResource ZsMonoFont}" FontSize="13" />
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Добавить" Command="{Binding AddOptionCommand}" Margin="8,0,0,0" />
                                <AutoCompleteBox ItemsSource="{x:Static vm:ProfileEditorViewModel.OptionNames}"
                                                 Text="{Binding SelectedOption}" FilterMode="Contains"
                                                 Watermark="Найти опцию: fooling, split, ttl…" MinimumPrefixLength="0" />
                              </DockPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Classes="small" Content="Добавить профиль" Command="{Binding AddProfileCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </TabItem>

        <!-- ═══ Поиск ═══ -->
        <TabItem AutomationProperties.Name="Поиск">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="icon" Stroke="{Binding $parent[TabItem].Foreground}"
                    Data="M13.5,8 A5.5,5.5 0 1 1 2.5,8 A5.5,5.5 0 1 1 13.5,8 Z M12,12 L16,16" />
              <TextBlock Text="Поиск" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer DataContext="{Binding Search}" x:DataType="vm:SearchViewModel">
            <StackPanel Spacing="12" MaxWidth="804" Margin="22,18" HorizontalAlignment="Stretch">
              <TextBlock Classes="h1" Text="Поиск стратегии" />

              <Border Classes="card" IsVisible="{Binding !IsWindows}">
                <TextBlock Classes="muted" Text="Поиск запускает движок, поэтому работает только под Windows." />
              </Border>

              <Border Classes="card">
                <Grid ColumnDefinitions="*,20,200">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Text="Сервисы: сайт вместе с его CDN (видео, картинки, вложения часто режут отдельно от сайта)" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Groups}" IsEnabled="{Binding !IsSearching}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TargetGroupOption">
                          <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Title}" Margin="0,0,16,0" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="caption" Text="Сайты и адреса файлов для проверки, по одному на строку" />
                    <TextBox Text="{Binding TargetsText}" AcceptsReturn="True" Height="140" IsEnabled="{Binding !IsSearching}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="caption" Text="Лимит времени" />
                    <ComboBox ItemsSource="{Binding Budgets}" SelectedItem="{Binding BudgetMinutes}"
                              IsEnabled="{Binding !IsSearching}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="sys:Int32">
                          <TextBlock Text="{Binding StringFormat='{}{0} мин'}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Margin="0,12,0,0">
                      <Button Classes="primary swap" Classes.hidden="{Binding IsSearching}" HorizontalAlignment="Stretch"
                              Content="Искать" Command="{Binding StartCommand}" />
                      <Button Classes="danger swap" Classes.hidden="{Binding !IsSearching}" HorizontalAlignment="Stretch"
                              Content="Остановить" Command="{Binding CancelCommand}" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Шаги: пока поиск не шёл, объясняют план; во время поиска показывают, где он сейчас. -->
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SearchStep">
                        <StackPanel Spacing="8" Margin="0,0,12,0">
                          <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="step" Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}">
                              <Panel>
                                <TextBlock Text="{Binding Number}" IsVisible="{Binding !IsDone}" />
                                <Path Data="M4,9 L7.2,12.2 L13,5.8" Stroke="{DynamicResource ZsAccentText}" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDone}" />
                              </Panel>
                            </Border>
                            <Border Grid.Column="1" Classes="stepLine" Classes.done="{Binding IsDone}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" IsVisible="{Binding !IsLast}" />
                          </Grid>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource ZsText}" />
                          <TextBlock Text="{Binding Hint}" Classes="caption" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" IsVisible="{Binding IsSearching}" />
                  <TextBlock Classes="caption" Text="На время поиска основной обход выключается и потом включается обратно." />
                </StackPanel>
              </Border>

              <Border Classes="card reveal" IsVisible="{Binding Phase, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="title" Text="{Binding Phase}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}"
                             IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <DockPanel Classes="reveal" IsVisible="{Binding Best, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Classes="primary" Content="Сохранить стратегию" Command="{Binding SaveResultCommand}" Margin="10,0,0,0" />
                    <TextBox Text="{Binding ResultName}" VerticalAlignment="Center" />
                  </DockPanel>
                </StackPanel>
              </Border>

              <Border Classes="card reveal" IsVisible="{Binding Tested.Count, Converter={x:Static app:Converters.IsPositive}}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="title" Text="Проверенные варианты" />
                  <ItemsControl ItemsSource="{Binding Tested}" Classes="appear">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ScoreRow">
                        <Grid ColumnDefinitions="*,Auto,80" Margin="0,3">
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ZsText}" Margin="0,0,12,0" />
                          <TextBlock Grid.Column="1" Classes="score" Classes.full="{Binding IsFull}" Classes.zero="{Binding IsZero}"
                                     Classes.failed="{Binding IsFailed}" Text="{Binding Result}" HorizontalAlignment="Right"
                                     Foreground="{DynamicResource ZsText}" />
                          <TextBlock Grid.Column="2" Text="{Binding Latency}" Classes="caption" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══ Настройки ═══ -->
        <TabItem AutomationProperties.Name="Настройки">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Classes="icon" Stroke="{Binding $parent[TabItem].Foreground}"
                    Data="M2.5,5.5 L6,5.5 M10,5.5 L15.5,5.5 M2.5,12.5 L9,12.5 M13,12.5 L15.5,12.5 M10,5.5 A2,2 0 1 1 6,5.5 A2,2 0 1 1 10,5.5 M13,12.5 A2,2 0 1 1 9,12.5 A2,2 0 1 1 13,12.5" />
              <TextBlock Text="Настройки" VerticalAlignment="Center" />
            </StackPanel>
          </TabItem.Header>
          <ScrollViewer>
            <StackPanel Spacing="10" MaxWidth="804" Margin="22,18" HorizontalAlignment="Stretch">
              <TextBlock Classes="h1" Text="Настройки" />

              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="title" Text="Оформление" />
                  <ItemsControl ItemsSource="{Binding Themes}" Margin="0,0,-8,-8">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ThemeOption">
                        <Button Classes="tile" Command="{Binding SelectCommand}" Margin="0,0,8,8"
                                AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Tagline}">
                          <Border Classes="tileFrame" Classes.selected="{Binding IsSelected}" Padding="3">
                            <StackPanel>
                              <Border Height="50" CornerRadius="5" ClipToBounds="True" Background="{Binding BackgroundBrush}">
                                <Panel>
                                  <c:BackdropView Kind="{Binding Theme.Backdrop}" EffectColor="{Binding Theme.Effect}" Animated="False" />
                                  <Border Width="16" HorizontalAlignment="Left" Background="{Binding SurfaceBrush}" Opacity="0.85" />
                                  <StackPanel Margin="24,10,8,0" Spacing="4">
                                    <Border Height="4" Width="40" CornerRadius="2" Background="{Binding TextBrush}" HorizontalAlignment="Left" />
                                    <Border Height="3" Width="56" CornerRadius="1.5" Background="{Binding MutedBrush}" HorizontalAlignment="Left" />
                                    <Border Height="8" Width="24" CornerRadius="3" Background="{Binding AccentBrush}" HorizontalAlignment="Left" Margin="0,3,0,0" />
                                  </StackPanel>
                                </Panel>
                              </Border>
                              <DockPanel Margin="5,5,3,3">
                                <Path DockPanel.Dock="Right" Data="M4,9 L7.2,12.2 L13,5.8" Stroke="{DynamicResource ZsAccent}" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" IsVisible="{Binding IsSelected}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ZsText}" />
                              </DockPanel>
                            </StackPanel>
                          </Border>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <DockPanel Classes="reveal" IsVisible="{Binding Theme.HasBackdrop}" Margin="0,2,0,0">
                    <ToggleSwitch DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding AnimatedBackdrop}"
                                  AutomationProperties.Name="Движение фона" Margin="16,0,0,0" />
                    <StackPanel Spacing="4">
                      <TextBlock Classes="title" Text="Движение фона" />
                      <TextBlock Classes="muted" Text="Выключите, если отвлекает или ноутбук греется: фон станет неподвижной картинкой. Когда в Windows выключены эффекты анимации, фон неподвижен всегда." />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,2,0,0">
                    <ToggleSwitch DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding MenuOnTop}"
                                  AutomationProperties.Name="Меню сверху" Margin="16,0,0,0" />
                    <StackPanel Spacing="4">
                      <TextBlock Classes="title" Text="Меню сверху" />
                      <TextBlock Classes="muted" Text="Вкладки строкой над содержимым вместо колонки слева. Содержимому достаётся вся ширина окна." />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <DockPanel>
                  <ToggleSwitch DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding WatchdogEnabled}"
                                AutomationProperties.Name="Сторож" Margin="16,0,0,0" />
                  <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="Сторож" />
                    <TextBlock Classes="muted" Text="Пока обход включён, раз в 5 минут проверяет YouTube, Discord и rutracker вместе с их CDN: видео, обложки, вложения, чат. Если сайты перестали открываться, сам подбирает стратегию получше, но не чаще раза в 30 минут. Если сайты не открывались с самого начала, стратегию не трогает и советует поиск." />
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border Classes="card">
                <DockPanel>
                  <ToggleSwitch DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding CloseToTray}"
                                AutomationProperties.Name="Сворачивать в трей" Margin="16,0,0,0" />
                  <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="Сворачивать в трей" />
                    <TextBlock Classes="muted" Text="Пока обход включён, крестик прячет окно, а обход продолжает работать. Выйти совсем можно из меню значка в трее." />
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding CanStartWithWindows}">
                <DockPanel>
                  <ToggleSwitch DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding StartWithWindows}"
                                AutomationProperties.Name="Запускать вместе с Windows" Margin="16,0,0,0" />
                  <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="Запускать вместе с Windows" />
                    <TextBlock Classes="muted" Text="При входе в Windows программа запускается свёрнутой в трей. Раздача включится сама, если в её карточке отмечено «Включать раздачу при запуске программы». Работает через Планировщик заданий: программе нужны права администратора, а из обычного автозапуска Windows такие программы не запускает." />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource ZsDanger}" Text="{Binding AutostartStatus}"
                               IsVisible="{Binding AutostartStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding CommunityEnabled}"
                                  AutomationProperties.Name="Обмен стратегиями с сообществом" Margin="16,0,0,0" />
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="title" Text="Обмен стратегиями" VerticalAlignment="Center" />
                        <Border Classes="chip warn" Margin="0" VerticalAlignment="Center">
                          <TextBlock Text="сервер ещё не запущен" />
                        </Border>
                      </StackPanel>
                      <TextBlock Classes="muted" Text="Приложение сможет брать стратегии из общей базы и отправлять туда найденные поиском. Анонимно. Пока сервера нет, переключатель только запоминается." />
                    </StackPanel>
                  </DockPanel>
                  <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Уходит" Classes="caption" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Grid.Column="1" Classes="muted" Margin="0,0,0,8"
                               Text="номер сети провайдера (ASN), регион, параметры стратегии и результат проверки. Только если поиск шёл по стандартным сайтам." />
                    <TextBlock Grid.Row="1" Text="Не уходит" Classes="caption" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted"
                               Text="ваши списки и сайты, журналы, история соединений. Сервер увидит только ваш IP-адрес, как любой сайт." />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card" DataContext="{Binding Blocklists}" x:DataType="vm:BlocklistsViewModel">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
                      <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsUpdating}" VerticalAlignment="Center" />
                      <Button Classes="small" Content="Обновить сейчас" Command="{Binding UpdateNowCommand}" />
                    </StackPanel>
                    <TextBlock Text="Списки блокировок" Classes="title" VerticalAlignment="Center" />
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SubscriptionStatus">
                        <StackPanel Margin="0,4" Spacing="2">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Info}" Classes="caption" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ZsText}" />
                          </DockPanel>
                          <TextBlock Classes="error reveal" Text="{Binding Error}"
                                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" Text="Обновляются, когда старше суток: при запуске и в фоне, пока приложение открыто. Движок подхватывает новые списки без перезапуска. Источники: Re:filter и antifilter community. Из списка IP выброшены подсети больше 65 536 адресов (там Cloudflare и Google) и служебные адреса. Если загрузка выглядит обрезанной, остаётся прежний список." />
                  <Border Height="1" Background="{DynamicResource ZsBorder}" Margin="0,4" />
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                      <Button Classes="small" Content="Пересчитать" Command="{Binding RefreshAutoCommand}" />
                      <Button Classes="small" Content="Очистить" Command="{Binding ClearAutoCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AutoInfo}" VerticalAlignment="Center" Foreground="{DynamicResource ZsText}" />
                  </DockPanel>
                  <TextBlock Classes="muted" Text="Автосписок ведёт сам движок. Если туда попал рабочий сайт и обход его ломает, впишите домен в exclude.txt, и больше он туда не попадёт." />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Свои списки" Classes="title" />
                  <TextBlock Classes="muted" Text="Файлы .txt, по домену на строку, поддомены подхватываются сами. general.txt и новые файлы ваши, blocked.txt перезаписывается при обновлении, в exclude.txt домены, которые обход не трогает. Когда новая версия приложения меняет встроенный general.txt, новые домены дописываются к вашему файлу, а ваши правки и удаления сохраняются." />
                  <SelectableTextBlock Classes="muted" Text="{Binding ListStore.Directory}" FontFamily="{DynamicResource ZsMonoFont}" FontSize="12" />
                  <Button Classes="small" Content="Открыть папку" Command="{Binding OpenListsFolderCommand}" IsEnabled="{Binding IsWindows}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <!-- Раздача: телефон ходит в интернет через прокси на ПК, и обход обрабатывает его соединения. -->
              <Border Classes="card" DataContext="{Binding Share}" x:DataType="vm:ShareViewModel">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <ToggleSwitch x:Name="ShareSwitch" DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding IsEnabled}"
                                  AutomationProperties.Name="Раздача на телефон" Margin="16,0,0,0" />
                    <StackPanel Spacing="4">
                      <TextBlock Classes="title" Text="Раздача на телефон" />
                      <TextBlock Classes="muted" Text="iPhone, Android или телевизор ходят в интернет через этот ПК со своим обходом. Раздача не зависит от обхода на главной: их можно включать и выключать по отдельности, и стратегия у раздачи своя. Работает, пока ПК включён и приложение запущено." />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Classes="caption" Text="Стратегия для телефона" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="ShareStrategy" ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StrategyItem">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </DockPanel>
                  <TextBlock Classes="reveal" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                  <!-- Телефон настраивается один раз, в той сети, где уже есть ПК; дальше всё работает само. -->
                  <Border Classes="code reveal" IsVisible="{Binding ShowPhoneSetup}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Настройка телефона, один раз" FontWeight="SemiBold" Foreground="{DynamicResource ZsText}" />
                      <StackPanel Spacing="6" IsVisible="{Binding !HomeDetected}">
                        <TextBlock Classes="caption" Text="{Binding HomeNote}" IsVisible="{Binding HomeNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Grid ColumnDefinitions="*,10,*">
                          <TextBox x:Name="HomeSsid" Text="{Binding HomeSsid}" Watermark="Имя домашней сети Wi-Fi" />
                          <TextBox Grid.Column="2" Text="{Binding HomePassword}" Watermark="Пароль (можно не вводить)" PasswordChar="•" />
                        </Grid>
                      </StackPanel>
                      <TextBlock Classes="caption" Text="{Binding HomeNote}" IsVisible="{Binding HomeDetected}" />
                      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ZsText}" IsVisible="{Binding CanMakeProfile}">
                        <Run Text="iPhone: в сети " /><Run Text="{Binding PhoneNetworkName}" FontWeight="SemiBold" FontFamily="{DynamicResource ZsMonoFont}" /><Run Text=" откройте в Safari адрес " /><Run Text="{Binding ProfileUrl}" FontWeight="SemiBold" FontFamily="{DynamicResource ZsMonoFont}" /><Run Text=" и установите профиль: Настройки → Профиль загружен → Установить. Пока ПК и приложение работают, iPhone в этой сети ходит через ПК с обходом, а когда ПК выключен, напрямую." />
                      </TextBlock>
                      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ZsText}">
                        <Run Text="Android: Wi-Fi → ваша сеть → Изменить → Дополнительно → Прокси → Автонастройка, адрес " /><Run Text="{Binding PhonePacUrl}" FontWeight="SemiBold" FontFamily="{DynamicResource ZsMonoFont}" /><Run Text="." />
                      </TextBlock>
                      <TextBlock Classes="caption" TextWrapping="Wrap">
                        <Run Text="Вручную: прокси " /><Run Text="{Binding Address}" FontFamily="{DynamicResource ZsMonoFont}" /><Run Text=", порт " /><Run Text="{Binding Port}" FontFamily="{DynamicResource ZsMonoFont}" /><Run Text=". Так тоже работает, но при выключенном ПК интернета в этой сети не будет, пока прокси не убрать. Через прокси идут браузеры и большинство приложений; звонки и голосовые чаты идут мимо ПК, без обхода." />
                      </TextBlock>
                      <TextBlock Classes="caption" Text="Адрес ПК может смениться, если роутер выдаст другой: тогда телефон будет ходить напрямую, а профиль нужно поставить заново. Чтобы адрес не менялся, закрепите его за ПК в настройках роутера." />
                      <ItemsControl ItemsSource="{Binding OtherAddresses}" IsVisible="{Binding OtherAddresses.Count, Converter={x:Static app:Converters.IsPositive}}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:String">
                            <TextBlock Classes="caption" Text="{Binding StringFormat='Другой адрес ПК: {0}'}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="caption" Text="{Binding LastClient}" IsVisible="{Binding LastClient, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="small" Content="Журнал раздачи" Command="{Binding OpenLogCommand}" IsEnabled="{Binding IsHotspotAvailable}"
                                ToolTip.Tip="Что просил телефон и чем кончилось. Этот файл пригодится, если телефон не подключается." />
                        <Button Classes="small" Content="Очистить журнал" Command="{Binding ClearLogCommand}"
                                ToolTip.Tip="Удаляет share.log и его прошлую часть." />
                      </StackPanel>
                      <CheckBox IsChecked="{Binding Main.ShareLogSites}" Content="Писать в журнал адреса сайтов" />
                      <TextBlock Classes="caption" TextWrapping="Wrap"
                                 Text="Без этой галки журнал хранит только сводку: сколько соединений прошло от каждого устройства и какие были ошибки. С ней в журнале видно, какие сайты открывали устройства. Включайте только на время разбора проблемы с конкретным сайтом и не пересылайте такой журнал без нужды." />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="small" Content="Проверить связь с телефоном" Command="{Binding CheckReachCommand}"
                                ToolTip.Tip="Минуту слушает порт прокси и говорит, где рвётся связь: прокси, брандмауэр на ПК или сеть." />
                      </StackPanel>
                      <TextBlock Text="{Binding ReachText}" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}"
                                 IsVisible="{Binding ReachText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Border>

                  <!-- Поиск программ, которые не пускают телефон к ПК: работает и без включённой раздачи. -->
                  <StackPanel Spacing="6" IsVisible="{Binding IsHotspotAvailable}">
                    <Button Classes="small" HorizontalAlignment="Left" Content="Найти мешающие программы" Command="{Binding FindConflictsCommand}"
                            ToolTip.Tip="Ищет файрволы, антивирусы и VPN, которые не пускают телефон к ПК, и говорит, что в них выключить. До минуты." />
                    <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}"
                               IsVisible="{Binding ConflictText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>

                  <!-- Автозапуск раздачи: при запуске программы и вместе с Windows (тогда программа стартует в трее). -->
                  <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding Main.ShareAutoStart}" Content="Включать раздачу при запуске программы" />
                    <CheckBox IsChecked="{Binding Main.StartWithWindows}" IsVisible="{Binding Main.CanStartWithWindows}"
                              Content="Запускать Zapret Smart вместе с Windows (свёрнутым в трей)" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Main.CanStartWithWindows}"
                               Text="Вместе обе галки дают раздачу сразу после включения ПК, без открытия окна. Автозапуск идёт через Планировщик заданий с правами администратора: иначе Windows не запустит программу при входе." />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource ZsDanger}" Text="{Binding Main.AutostartStatus}"
                               IsVisible="{Binding Main.AutostartStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>

                  <!-- Запасной вариант, когда общего Wi-Fi нет: ПК сам становится сетью. Не включается сам. -->
                  <Expander Header="Нет общего Wi-Fi: точка доступа ПК" IsVisible="{Binding IsHotspotAvailable}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding HotspotText}" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}" />
                      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ZsText}" IsVisible="{Binding IsHotspotOn}">
                        <Run Text="Сеть " /><Run Text="{Binding Hotspot.Ssid}" FontFamily="{DynamicResource ZsMonoFont}" FontWeight="SemiBold" /><Run Text=", пароль " /><Run Text="{Binding Hotspot.Passphrase}" FontFamily="{DynamicResource ZsMonoFont}" FontWeight="SemiBold" />
                      </TextBlock>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="small" Content="Включить точку доступа" Command="{Binding StartHotspotCommand}" IsVisible="{Binding !IsHotspotOn}" />
                        <Button Classes="small" Content="Выключить точку доступа" Command="{Binding StopHotspotCommand}" IsVisible="{Binding IsHotspotOn}" />
                        <Button Classes="small subtle" Content="Обновить" Command="{Binding RefreshHotspotCommand}" />
                        <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsHotspotBusy}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="caption" Text="Точку доступа, включённую здесь, приложение выключает при выходе. Если домашняя сеть не указана, профиль iPhone и адреса выше будут для сети точки доступа." />
                      <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Classes="small" Content="Проверить" Command="{Binding ProbeCommand}" Margin="16,0,0,0" VerticalAlignment="Top" />
                        <StackPanel Spacing="2">
                          <TextBlock Text="Обычная раздача без прокси" FontWeight="SemiBold" Foreground="{DynamicResource ZsText}" />
                          <TextBlock Classes="caption" Text="Пока не работает: неизвестно, видит ли движок трафик устройств на точке доступа. Проверка это выясняет: включите точку доступа, подключите телефон без прокси и нажмите «Проверить». Трафик только читается, интернет и обход она не трогает." />
                        </StackPanel>
                      </DockPanel>
                      <TextBlock Classes="reveal" Text="{Binding ProbeText}" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}"
                                 IsVisible="{Binding ProbeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsProbing}" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>

              <Border Classes="card" DataContext="{Binding Hosts}" x:DataType="vm:HostsViewModel">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" Classes="bare" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsAvailable}"
                                  AutomationProperties.Name="Файл hosts" Margin="16,0,0,0" />
                    <StackPanel Spacing="4">
                      <TextBlock Classes="title" Text="Файл hosts" />
                      <TextBlock Classes="muted" Text="Дописывает в системный hosts адреса GitHub, Telegram и Discord из списка Flowseal (MIT), чтобы они открывались при подмене DNS. Ваши записи не трогаются: блок приложения стоит между метками в конце файла, а если имя уже задано вами, главной остаётся ваша запись. Список обновляется вместе со списками блокировок." />
                    </StackPanel>
                  </DockPanel>
                  <TextBlock Classes="reveal" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="small" Content="Обновить сейчас" Command="{Binding UpdateNowCommand}" />
                    <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                  </StackPanel>
                  <Expander Header="Записи приложения в hosts" IsVisible="{Binding Entries.Count, Converter={x:Static app:Converters.IsPositive}}">
                    <ScrollViewer MaxHeight="180">
                      <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:String">
                            <TextBlock Classes="log" Text="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Expander>
                  <TextBlock Classes="caption" IsVisible="{Binding IsAvailable}"
                             Text="{Binding BackupPath, StringFormat='Копия файла перед каждым изменением: {0}'}" />
                </StackPanel>
              </Border>

              <Border Classes="card" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="caption" VerticalAlignment="Center"
                               Text="{Binding Current, StringFormat='установлена {0}'}" />
                    <TextBlock Classes="title" Text="Версия приложения" />
                  </DockPanel>
                  <TextBlock Classes="muted" Text="Обновление или откат на любую опубликованную версию. Архив скачивается с GitHub и сверяется по SHA-256 с файлом сумм того же релиза; при несовпадении ничего не ставится. Настройки, свои стратегии и списки остаются: они лежат отдельно, в папке данных." />
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                      <Button Classes="small" Content="Проверить" Command="{Binding CheckCommand}" />
                      <Button x:Name="InstallButton" Classes="primary small" Content="Установить" IsEnabled="{Binding CanInstallNow}">
                        <Button.Flyout>
                          <Flyout Placement="TopEdgeAlignedRight">
                            <StackPanel Spacing="8" MaxWidth="280">
                              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}"
                                         Text="{Binding Selected.Release.Version, StringFormat='Установить {0}?', FallbackValue=''}" />
                              <TextBlock Classes="caption" Text="Обход выключится, приложение закроется и через несколько секунд откроется в выбранной версии. Если замена файлов не удастся, вернутся прежние." />
                              <Button Classes="primary small" Content="Установить" Margin="0,4,0,0" Click="OnInstallConfirmed" />
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch"
                              PlaceholderText="Список версий ещё не загружен" IsEnabled="{Binding !IsBusy}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReleaseOption">
                          <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource ZsText}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Classes="caption" IsVisible="{Binding !CanInstallHere}"
                             Text="Установка доступна в собранном приложении на Windows." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>

      <!-- Состояние видно с любой вкладки. -->
      <StackPanel Classes="status" Spacing="3" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="8" Height="8" Classes="dot" Classes.on="{Binding IsRunning}" Classes.busy="{Binding IsBusy}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusShort}" FontSize="12" Foreground="{DynamicResource ZsText}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="version caption" Text="{x:Static vm:MainWindowViewModel.VersionText}" Margin="16,0,0,0" />
      </StackPanel>
    </Grid>

    <Panel x:Name="OverlayHost" IsHitTestVisible="False" />
  </Panel>
</Window>
