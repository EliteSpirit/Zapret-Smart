<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZapretSmart.App.App"
             RequestedThemeVariant="Dark">
  <!--
    Цвета, скругления и шрифт приходят из темы (Theming/ThemeResources.cs) и подменяются на лету,
    поэтому здесь везде DynamicResource. StaticResource перестал бы обновляться при смене темы.
  -->

  <Application.Styles>
    <FluentTheme />

    <!-- Текст -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource ZsTextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ZsTextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ZsDanger}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Поверхности -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource ZsSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ZsCardRadius}" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.code">
      <Setter Property="Background" Value="{DynamicResource ZsCode}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ZsControlRadius}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource ZsSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="Border.chip.accent">
      <Setter Property="Background" Value="{DynamicResource ZsAccentSoft}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.chip.warn">
      <Setter Property="Background" Value="{DynamicResource ZsWarningSoft}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.chip.warn > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ZsWarning}" />
    </Style>

    <!-- Навигация -->
    <!--
      Рамка окна: меню колонкой слева (по умолчанию) или строкой сверху (класс top-menu на окне).
      Колонка узкая, 172 px: на странице с контентом до 760 px она не должна отъедать ширину.
    -->
    <Style Selector="Border.chrome">
      <Setter Property="Background" Value="{DynamicResource ZsSidebar}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsBorder}" />
      <Setter Property="Width" Value="172" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="StackPanel.logo">
      <Setter Property="Margin" Value="22,20,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Spacing" Value="1" />
    </Style>
    <Style Selector="StackPanel.status">
      <Setter Property="Margin" Value="22,0,0,16" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Width" Value="140" />
    </Style>
    <Style Selector="TabControl.nav">
      <Setter Property="TabStripPlacement" Value="Left" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl.nav /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="10,64,10,12" />
    </Style>
    <Style Selector="TabControl.nav TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Width" Value="152" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="CornerRadius" Value="{DynamicResource ZsControlRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsTextMuted}" />
      <Setter Property="Background" Value="{DynamicResource ZsRaisedClear}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TabControl.nav TabItem /template/ Border#PART_LayoutRoot">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TabControl.nav TabItem:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="TabControl.nav TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource ZsHover}" />
    </Style>
    <!-- Нажатие не красит пункт системным серым Fluent: тот же цвет, что при наведении. -->
    <Style Selector="TabControl.nav TabItem:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource ZsHover}" />
    </Style>
    <Style Selector="TabControl.nav TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource ZsSurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="TabControl.nav TabItem:selected /template/ Border#PART_LayoutRoot, TabControl.nav TabItem:selected:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource ZsSurfaceRaised}" />
    </Style>
    <Style Selector="TabControl.nav TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{DynamicResource ZsAccent}" />
    </Style>
    <!-- Меню сверху: полоса высотой 56 px, логотип слева, вкладки за ним, состояние справа. -->
    <Style Selector="Window.top-menu Border.chrome">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="56" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Window.top-menu StackPanel.logo">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="24,0,0,0" />
      <Setter Property="Height" Value="56" />
    </Style>
    <Style Selector="Window.top-menu StackPanel.status">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="56" />
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="14" />
    </Style>
    <Style Selector="Window.top-menu StackPanel.status > StackPanel, Window.top-menu StackPanel.status > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.top-menu TextBlock.version">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Window.top-menu TabControl.nav">
      <Setter Property="TabStripPlacement" Value="Top" />
    </Style>
    <Style Selector="Window.top-menu TabControl.nav /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="160,8,260,8" />
    </Style>
    <Style Selector="Window.top-menu TabControl.nav TabItem">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style Selector="Path.icon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      Кнопки. Fluent красит фон, рамку и текст на части шаблона PART_ContentPresenter при наведении и нажатии,
      поэтому цвет, заданный самой кнопке, при наведении пропадал: «Включить» становилась серой.
      Для primary и danger состояния задаются там же, на части шаблона.
    -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{DynamicResource ZsControlRadius}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="0.23,1,0.32,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource ZsAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsAccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="24,11" />
    </Style>
    <Style Selector="Button.primary.small">
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsAccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsAccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsAccentText}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsAccentPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsAccentPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsAccentText}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource ZsDangerClear}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsDanger}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsDanger}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="24,11" />
    </Style>
    <Style Selector="Button.danger.small">
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsDangerSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsDanger}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsDanger}" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsDangerClear}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrushDisabled}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
    </Style>

    <!-- Тихая кнопка без рамки: второстепенное действие внутри карточки. -->
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="{DynamicResource ZsRaisedClear}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ZsTextMuted}" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsRaisedClear}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Нажатие: кнопка чуть сжимается. Fluent делает то же рывком, здесь плавно. -->
    <Style Selector="Window:not(.reduced-motion) Button:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Window.reduced-motion Button:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!--
      Пара «Включить / Выключить» на одном месте: видна та, что сейчас доступна, смена через короткий кроссфейд.
      Скрытая кнопка всегда недоступна (её команда не может выполниться), поэтому фокус на неё не попадает.
    -->
    <Style Selector="Button.swap">
      <Setter Property="MinWidth" Value="168" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="0.23,1,0.32,1" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="0.23,1,0.32,1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.swap.hidden">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Window:not(.reduced-motion) Button.swap.hidden">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>

    <!-- Плитка темы: вся карточка кликабельна, рамка показывает выбранную. -->
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter, Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tile:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Window:not(.reduced-motion) Button.tile:pressed">
      <Setter Property="RenderTransform" Value="scale(0.985)" />
    </Style>
    <Style Selector="Border.tileFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource ZsBorder}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="{DynamicResource ZsCardRadius}" />
      <Setter Property="Background" Value="{DynamicResource ZsSurfaceRaised}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tile:pointerover Border.tileFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource ZsBorderStrong}" />
    </Style>
    <Style Selector="Border.tileFrame.selected, Button.tile:pointerover Border.tileFrame.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource ZsAccent}" />
    </Style>

    <!-- Переключатель без подписи «вкл/выкл»: подпись описывает настройку, а состояние видно по самому переключателю. -->
    <Style Selector="ToggleSwitch.bare">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Список-выбор (стратегии): выделение как в навигации, плюс полоска акцента. -->
    <Style Selector="ListBox.picker">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.picker ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ZsControlRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="ListBox.picker ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsRaisedClear}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.picker ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.picker ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsHover}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="ListBox.picker ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ZsSurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
    </Style>
    <Style Selector="ListBox.picker ListBoxItem Border.pipe">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Background" Value="{DynamicResource ZsAccent}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.picker ListBoxItem:selected Border.pipe">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Всплывающее подтверждение: появляется из кнопки, а не из центра. -->
    <Style Selector="FlyoutPresenter">
      <Setter Property="CornerRadius" Value="{DynamicResource ZsCardRadius}" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="FlyoutPresenter.animated">
      <Setter Property="RenderTransformOrigin" Value="0%,100%" />
      <Style.Animations>
        <Animation Duration="0:0:0.16" Easing="0.23,1,0.32,1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.96" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!--
      Движение. Кривая ease-out с сильным стартом (0.23,1,0.32,1): отклик виден сразу. Всё короче 300 мс.
      Анимируются только прозрачность и трансформации.
      .reduced-motion на окне (в Windows выключены эффекты анимации) убирает движение и оставляет смену прозрачности и цвета.
    -->

    <!-- Индикатор статуса: точка меняет цвет плавно. -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Fill" Value="{DynamicResource ZsTextMuted}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Fill" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Ellipse.dot.on">
      <Setter Property="Fill" Value="{DynamicResource ZsAccent}" />
    </Style>
    <Style Selector="Ellipse.dot.busy">
      <Setter Property="Fill" Value="{DynamicResource ZsWarning}" />
    </Style>
    <Style Selector="Ellipse.dot.saved">
      <Setter Property="Fill" Value="{DynamicResource ZsAccent}" />
    </Style>
    <Style Selector="Ellipse.dot.pending">
      <Setter Property="Fill" Value="{DynamicResource ZsWarning}" />
    </Style>
    <Style Selector="Ellipse.pulse">
      <Setter Property="Fill" Value="{DynamicResource ZsAccent}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Ellipse.pulse.busy">
      <Setter Property="Fill" Value="{DynamicResource ZsWarning}" />
    </Style>
    <!--
      При включении кольцо расходится трижды и затихает: это подтверждение, а не вечное движение перед глазами.
      Пока сторож подбирает стратегию, кольцо пульсирует без остановки, как индикатор работы.
    -->
    <Style Selector="Window:not(.reduced-motion) Ellipse.pulse.on">
      <Style.Animations>
        <Animation Duration="0:0:1.8" IterationCount="3">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="2.4" />
            <Setter Property="ScaleTransform.ScaleY" Value="2.4" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window:not(.reduced-motion) Ellipse.pulse.busy">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="2.4" />
            <Setter Property="ScaleTransform.ScaleY" Value="2.4" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- Шаги поиска -->
    <Style Selector="Border.step">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource ZsBorderStrong}" />
      <Setter Property="Background" Value="{DynamicResource ZsAccentClear}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.step TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ZsTextMuted}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.step.active">
      <Setter Property="BorderBrush" Value="{DynamicResource ZsAccent}" />
      <Setter Property="Background" Value="{DynamicResource ZsAccentSoft}" />
    </Style>
    <Style Selector="Border.step.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ZsAccent}" />
    </Style>
    <Style Selector="Border.step.done">
      <Setter Property="BorderBrush" Value="{DynamicResource ZsAccent}" />
      <Setter Property="Background" Value="{DynamicResource ZsAccent}" />
    </Style>
    <Style Selector="Border.stepLine">
      <Setter Property="Height" Value="2" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Background" Value="{DynamicResource ZsBorder}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.stepLine.done">
      <Setter Property="Background" Value="{DynamicResource ZsAccent}" />
    </Style>

    <!-- Журнал и результаты поиска -->
    <Style Selector="TextBlock.log">
      <Setter Property="FontFamily" Value="{DynamicResource ZsMonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource ZsText}" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="TextBlock.log.warn">
      <Setter Property="Foreground" Value="{DynamicResource ZsWarning}" />
    </Style>
    <Style Selector="TextBlock.log.cmd">
      <Setter Property="Foreground" Value="{DynamicResource ZsTextMuted}" />
    </Style>
    <Style Selector="TextBlock.score.full">
      <Setter Property="Foreground" Value="{DynamicResource ZsAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.score.zero">
      <Setter Property="Foreground" Value="{DynamicResource ZsTextMuted}" />
    </Style>
    <Style Selector="TextBlock.score.failed">
      <Setter Property="Foreground" Value="{DynamicResource ZsDanger}" />
    </Style>

    <!-- Новые строки в списке проверенных вариантов появляются, а не выскакивают. -->
    <Style Selector="Window:not(.reduced-motion) ItemsControl.appear ContentPresenter">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="0.23,1,0.32,1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-4" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!--
      Блоки, которые показываются по ходу дела (статус сторожа, итог поиска, ошибки), проявляются за 200 мс.
      Срабатывает в момент, когда IsVisible становится True.
    -->
    <Style Selector="Window:not(.reduced-motion) :is(Control).reveal[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="0.23,1,0.32,1">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-4" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Window.reduced-motion :is(Control).reveal[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.15">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Application.Styles>
</Application>
